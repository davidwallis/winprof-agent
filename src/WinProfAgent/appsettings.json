{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "WindowSeconds": 60,
    "SampleHz": 100,
    "BufferSizeMB": 64,
    "QueueCapacity": 100,
    "SessionRecycleWindows": 30,
    "Metrics": {
      "Enabled": true,
      "OtlpEndpoint": "http://localhost:4317",
      "ExportIntervalSeconds": 15
    },
    "Pyroscope": {
      "Url": "http://localhost:4040",
      "MaxAttempts": 3,
      "Labels": { "env": "dev" }
    },
    "Processes": {
      "Targets": [],
      "Exclude": [ "System", "Idle" ]
    },
    "Symbols": {
      "SymbolFolder": "C:\\symbols",
      "PdbSearchPaths": [],
      "AllowDownload": true,
      "SymbolServers": [ "https://msdl.microsoft.com/download/symbols" ],
      "MissingRetryMinutes": 10
    }
  }
}
