{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "WindowSeconds": 15,
    "SampleHz": 100,
    "BufferSizeMB": 64,
    "QueueCapacity": 100,
    "SessionRecycleWindows": 30,
    "Metrics": {
      "Enabled": true,
      "OtlpEndpoint": "http://localhost:4317",
      "ExportIntervalSeconds": 15
    },
    "Pyroscope": {
      "Url": "http://localhost:4040",
      "MaxAttempts": 3,
      "Labels": { "env": "dev" }
    },
    "Processes": {
      "Targets": [
        { "Name": "net10-demo",    "Process": "busy.exe" },
        { "Name": "fx-demo-app",   "Process": "FxBusy.exe" },
        { "Name": "native-demo",   "Process": "BusyNative.exe" },
        { "Name": "com-demo",      "Process": "dllhost.exe", "CommandLineContains": "{5A6E1B1E-7C0D-4D8E-9B53-0A1D5F7A1C04}" }
      ],
      "Exclude": [ "System", "Idle" ]
    },
    "Symbols": {
      "SymbolFolder": "C:\\symbols",
      "PdbSearchPaths": [],
      "AllowDownload": true,
      "SymbolServers": [ "https://msdl.microsoft.com/download/symbols" ],
      "MissingRetryMinutes": 10
    }
  }
}
