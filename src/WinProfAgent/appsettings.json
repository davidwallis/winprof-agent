{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "WindowSeconds": 60,
    "SampleHz": 100,
    "Pyroscope": {
      "Url": "http://localhost:4040",
      "Labels": { "env": "dev" }
    },
    "Processes": {
      "Include": [],
      "Exclude": [ "System", "Idle" ]
    },
    "Symbols": {
      "PdbSearchPaths": []
    }
  }
}
